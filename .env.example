# Copy to .env.local. Never commit actual values.
ADMIN_USERNAME=
# Choose a unique passphrase of at least 20 characters.
ADMIN_PASSWORD=
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_SESSION_SECRET=
# Exact production origin, no trailing slash. Local default: http://localhost:3000
APP_ORIGIN=
# Dedicated Neon PostgreSQL connection string. Required on Vercel.
DATABASE_URL=
# Dedicated PUBLIC Vercel Blob store. Required for production uploads.
BLOB_READ_WRITE_TOKEN=
